# 统一换行符，避免 Windows 提交时整库出现 CRLF 变更噪音。
# 仓库内存 LF，检出时由各人编辑器决定。
* text=auto eol=lf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico  binary
*.woff2 binary
*.xlsx binary

# 生成物不计入语言统计
site/dist/** linguist-generated=true
site/src/content/** linguist-generated=true
