# ============================================================================
# Hair Dryer Lab — 仓库忽略规则
# ============================================================================

# ---- 凭据：绝对不能入库 ----------------------------------------------------
# site/.env 含 Levanta / PartnerBoost / Artemis 的 API 密钥与 Amazon Associates tag。
# site/.env.example 是模板（无值），**要入库**。
.env
.env.local
.env.*.local
*.pem
*.key
!*.example

# ---- 依赖与构建产物 --------------------------------------------------------
node_modules/
dist/
.astro/
.pnpm-store/
.pnpm-debug.log*

# ---- 体积大且可再生的中间产物 ----------------------------------------------
# analysis/ 是脚本生成的检查报告（合规/死链/构建验证等），每跑一次就覆盖，
# 体积已超 100 MB。需要时重跑 _scripts/ 下的脚本即可。
analysis/

# 原始市场数据：Semrush 导出与 ASIN 抓取结果。属于研究输入，体积大，
# 且含第三方数据，不随代码库分发。
semrush数据/
asin数据/

# ---- 第三方参考资料 --------------------------------------------------------
# 外部交付的 skill/规范材料，非本项目产出。
_ref/

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# ---- 编辑器 / 操作系统 -----------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# ---- 日志与临时文件 --------------------------------------------------------
*.log
tmp/
temp/

# ---- 临时克隆（用于验证干净环境构建）--------------------------------------
_clonetest/
_buildtest/
