---
/** Footer —— 遵循品牌规范 §24（结构 + Canada 行）/ §37（披露） */
import {
  FOOTER_MAIN, FOOTER_COMPANY, FOOTER_CANADA_LINE, SITE_NAME,
} from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-cols">
    <div>
      <img
        class="footer-logo"
        src="/brand/logo-lockup.png"
        alt={SITE_NAME}
        width="599" height="64"
        loading="lazy" decoding="async"
      />
      <p class="footer-brandline">{FOOTER_CANADA_LINE}</p>
    </div>

    <!--
      页脚分栏标签用 <p> 而不是 <h3>。
      此前是三个 <h3> 被 CSS 渲染成 12px —— 同样违反 §17（H3 应 24px），
      而且页脚链接组不是文档章节。导航组改用 <nav aria-labelledby> 提供
      无障碍名称；可见文字仍由 <p class="footer-col__title"> 承担。
    -->
    <nav class="footer-col" aria-labelledby="footer-nav-title">
      <p class="footer-col__title" id="footer-nav-title">Navigation</p>
      <ul>
        {FOOTER_MAIN.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-labelledby="footer-company-title">
      <p class="footer-col__title" id="footer-company-title">Company</p>
      <ul>
        {FOOTER_COMPANY.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col">
      <p class="footer-col__title">Disclosure</p>
      <p class="footer-brandline">
        Hair Dryer Lab may earn a commission when you buy through our links.
        This doesn't affect how we test or review products.
      </p>
      <ul>
        <li><a href="/affiliate-disclosure/">Read the full disclosure</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {year} {SITE_NAME}. hairdryerlab.ca</p>
    <p>
      <a href="/privacy-policy/">Privacy Policy</a> ·
      <a href="/terms/">Terms</a> ·
      <a href="/editorial-policy/">Editorial Policy</a>
    </p>
  </div>
</footer>
