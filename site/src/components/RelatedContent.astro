---
/**
 * §55(18) Related Content —— 文章尾部的相关阅读。
 *
 * 数据来自 frontmatter 的 `related`（URL 字符串数组）。
 * URL → 标题的解析在页面层完成（见 [...slug].astro），
 * 因为布局拿不到其它集合的条目。
 */
interface Item {
  href: string;
  label: string;
  /** 可选分组标签，例如 "Review" / "Guide" */
  kind?: string;
}
interface Props {
  items: Item[];
  title?: string;
}
const { items, title = 'Related reading' } = Astro.props;
---

{items && items.length > 0 && (
  <nav class="related" aria-labelledby="related-title">
    <p class="related__title" id="related-title">{title}</p>
    <ul class="related__list">
      {items.map((it) => (
        <li class="related__item">
          <a href={it.href}>{it.label}</a>
          {it.kind && <span class="muted small"> · {it.kind}</span>}
        </li>
      ))}
    </ul>
  </nav>
)}
