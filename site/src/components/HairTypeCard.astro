---
/**
 * §55(16) Hair-Type Card —— 发质入口卡。
 * §75：信息优先，不做大色块装饰；顶部 3px navy 作为类目标识。
 *
 * 传 items 渲染一组；单项也可传长度为 1 的数组。
 */
interface Item {
  href: string;
  name: string;
  blurb: string;
  image?: string;
  imageAlt?: string;
}
interface Props {
  items: Item[];
  title?: string;
}
const { items, title } = Astro.props;
---

{title && <h2 class="section-title">{title}</h2>}
<div class="tile-grid">
  {items.map((it) => (
    <a class="tile tile--hair" href={it.href}>
      {it.image && (
        <figure class="tile__media">
          <img src={it.image} alt={it.imageAlt ?? ''} loading="lazy" decoding="async" />
        </figure>
      )}
      <p class="tile__name">{it.name}</p>
      <p class="tile__blurb">{it.blurb}</p>
    </a>
  ))}
</div>
