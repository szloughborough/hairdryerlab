# ============================================================================
# 联盟网络 API 凭据 —— 复制为 .env 后填入真实值
# ============================================================================
#   copy .env.example .env
#
# .env 已在 .gitignore 中，不会被提交。凭据只在本机读取。
# 变量留空 = 该网络不参与同步（不会报错，对应 token 记为 pending）。
#
# 三个生产 API 均已实测可连通（2026-10-02），只差有效凭据：
#   app.levanta.io        → 401 需要 Bearer token
#   app.partnerboost.com  → {"status":{"code":1000,"msg":"Publisher does not exist"}}
#   api.artemisads.com    → 401 Unauthorized
# ============================================================================


# ---------------------------------------------------------------------------
# 1) Levanta —— Creator API v2  ✅ 已按官方 OpenAPI 实现，填入 key 即可用
#
#    拿 key：Levanta 后台 → 设置 / API → Create API key
#    规范：https://app.levanta.io/api/creator/v2/openapi.json
#    认证：Authorization: Bearer {api_key}
# ---------------------------------------------------------------------------
LEVANTA_API_KEY=
# API 基址（已含 v2 前缀，一般不用改）
LEVANTA_BASE_URL=https://app.levanta.io/api/creator/v2
# 站点面向加拿大，必须是 amazon.ca
LEVANTA_MARKETPLACE=amazon.ca


# ---------------------------------------------------------------------------
# 2) PartnerBoost —— Partner API  ✅ 已按官方文档实现，填入 token 即可用
#
#    拿 token：Partner 后台 → Token manage → 选中推广渠道 → 复制该渠道的 token
#              （每个渠道一个 token，不是账号级的）
#    端点：POST https://app.partnerboost.com/api/datafeed/get_amazon_link_by_asin
#          注意 Amazon 系列走 /api/datafeed/*，不是 api.php?mod=&op=
#    认证：token 放在请求体里，没有鉴权 header
# ---------------------------------------------------------------------------
PARTNERBOOST_TOKEN=
PARTNERBOOST_BASE_URL=https://app.partnerboost.com
# 国家码（两位）：CA = 加拿大。填 amazon.ca 也能自动纠正
PARTNERBOOST_COUNTRY=CA


# ---------------------------------------------------------------------------
# 3) ArtemisAds —— Open API  ⏳ 认证已确认，建链接口待补
#
#    拿 key：ArtemisAds 后台 → Settings → Open API → Generate
#    认证：请求头 x-aa-authorization: Bearer {api_key}
#    基址：https://api.artemisads.com/openapi/<publisher|seller>/<endpoint>
# ---------------------------------------------------------------------------
ARTEMIS_API_KEY=
ARTEMIS_BASE_URL=https://api.artemisads.com/openapi/publisher/v1
# marketplace（amazon.ca = 加拿大）。留空则用默认值 amazon.ca
ARTEMIS_MARKETPLACE=amazon.ca
# 可选：推广来源 ID（GET /sources 取）。留空则不带带 sourceId
ARTEMIS_SOURCE_ID=


# ---------------------------------------------------------------------------
# 同步行为
# ---------------------------------------------------------------------------
# 请求超时（秒）
AFFILIATE_HTTP_TIMEOUT=30
# 调试：1 = 打印每次请求的 URL / 状态码（不打印密钥）
AFFILIATE_DEBUG=0

# ---------------------------------------------------------------------------
# 4) Amazon Associates —— 兜底追踪 tag
#
#    这不是 API，只是链接尾部的 tag 参数，因此无需凭据、无需同步脚本。
#    优先级：联盟网络链接优先；网络拿不到的商品才用这个 tag 兜底。
#    同一商品绝不叠加两种追踪参数（会同时违反两边的运营协议）。
#
#    代码里已内置同样的默认值（src/data/affiliate-products.mjs），
#    这里留空 = 用内置默认值；填了 = 覆盖默认值。
# ---------------------------------------------------------------------------
AMAZON_ASSOCIATE_TAG=baldselect06b-20
